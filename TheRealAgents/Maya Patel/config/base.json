{
  "agent": "Maya Patel",
  "role": "Signal Classifier",
  "vertical": "general",

  "cycle": {
    "sleep_between_cycles": 30,
    "batch_size": 20,
    "max_llm_calls_per_cycle": 50
  },

  "classification": {
    "min_text_length": 50,
    "confidence_threshold": 0.4,
    "enable_llm": true
  },

  "llm": {
    "model": "openai/gpt-oss-120b",
    "timeout": 60,
    "temperature": 0.2,
    "max_tokens": 15000
  },

  "gap_detection": {
    "enabled": true,
    "run_every_n_cycles": 3,
    "batch_size": 500,
    "min_cluster_size": 2,
    "page_generation": {
      "enabled": true
    }
  }
}
