{
    "agent_name": "Agent_3",
    "role": "Gap Validator",
    "description": "Validates market gaps by searching for existing competitors and solutions",
    "vertical": "general",
    "sources": {
        "web_search": true
    },
    "paths": {
        "memory_dir": "memory",
        "state_dir": "memory/state",
        "logs_dir": "logs"
    },
    "round": {
        "sleep_between_rounds": 600,
        "max_round_minutes": 10
    },
    "llm": {
        "model": "xiaomi/mimo-v2-flash",
        "max_tokens": 500,
        "timeout": 15
    },
    "validation": {
        "batch_size": 5,
        "min_signals_for_validation": 5,
        "only_validate_unvalidated": true
    }
}
